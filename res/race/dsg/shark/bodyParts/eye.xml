<?xml version='1.0' encoding='UTF-8' standalone='no'?>
<eye>
	<!-- GENERAL INFORMATION: If you are unsure of anything, please use the LT Discord to ask for help! -->
	
	<!-- If you want to see the part of the code where this type is defined, then please look here:
	https://github.com/Innoxia/liliths-throne-public/blob/dev/src/com/lilithsthrone/game/character/body/abstractTypes/AbstractEyeType.java -->
	
	<!-- The id of the race which this eye belongs to.
	This will almost always be the id of the race in which this type is found (in this case hyena). -->
	<race>dsg_shark</race>
	
	<!-- The name that will be used when referring to transformations related to this type (such as when changing body parts in the self-TF menu). -->
	<transformationName><![CDATA[鲨鱼]]></transformationName>
	
	<!-- The id of the material covering this eye.
	Hard-coded values can be found here: https://github.com/Innoxia/liliths-throne-public/blob/dev/src/com/lilithsthrone/game/character/body/coverings/BodyCoveringType.java -->
	<coveringType>dsg_shark_eye</coveringType>
	
	<tags>
		<tag>NIGHT_VISION</tag>
	</tags>
	
	<!-- The default number of pairs that this eye type should have (should most likely be 1). -->
	<defaultPairCount>1</defaultPairCount>
	
	<!-- The default shape that the iris should have.
	Values can be found here: https://github.com/Innoxia/liliths-throne-public/blob/dev/src/com/lilithsthrone/game/character/body/valueEnums/EyeShape.java -->
	<defaultIrisShape>ROUND</defaultIrisShape>
	
	<!-- The default shape that the pupil should have.
	Values can be found here: https://github.com/Innoxia/liliths-throne-public/blob/dev/src/com/lilithsthrone/game/character/body/valueEnums/EyeShape.java -->
	<defaultPupilShape>VERTICAL</defaultPupilShape>
	
	<!-- The singular and plural names of this eye. -->
	<name><![CDATA[眼睛]]></name>
	<namePlural><![CDATA[眼睛]]></namePlural>
	
	<!-- The descriptors which should be drawn upon when describing a masculine character's eye of this type. -->
	<descriptorsMasculine>
		<descriptor><![CDATA[猎食性]]></descriptor>
	</descriptorsMasculine>
	<!-- Same as above, but for feminine characters. -->
	<descriptorsFeminine>
		<descriptor><![CDATA[猎食性]]></descriptor>
	</descriptorsFeminine>
	
	<!-- The description which is shown when a character transforms to obtain this eye type.
	This description immediately follows a brief description of the eye type undergoing a transformation. -->
	<transformationDescription><![CDATA[
		当[npc.she]犹豫地再次睁开双眼时，它们变成了一对大虹膜竖直瞳孔的鲨鱼眼睛。
		<br/>[npc.Name]现在拥有[style.boldShark(鲨鱼一般的眼睛)]，有着[style.boldGenericTF([npc.irisShape])]的[npc.irisFullDescription(true)]和[style.boldGenericTF([npc.pupilShape])]的[npc.pupilFullDescription(true)]。
	]]></transformationDescription>
	
	<!-- How this eye is described in a character's description page. -->
	<bodyDescription><![CDATA[
		[npc.SheHasFull]拥有[npc.eyePairs]鲨鱼的眼睛，其瞳孔和虹膜都大于常人。[npc.irisColour(true)]虹膜呈[npc.irisShape]，[npc.pupilColour(true)]瞳孔呈[npc.pupilShape]，还有着[npc.scleraColour(true)]的巩膜。
]]></bodyDescription>
	
</eye>
