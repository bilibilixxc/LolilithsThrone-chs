<?xml version='1.0' encoding='UTF-8' standalone='no'?>
<torso>
	<!-- GENERAL INFORMATION: If you are unsure of anything, please use the LT Discord to ask for help! -->
	
	<!-- If you want to see the part of the code where this type is defined, then please look here:
	https://github.com/Innoxia/liliths-throne-public/blob/dev/src/com/lilithsthrone/game/character/body/abstractTypes/AbstractTorsoType.java -->
	
	<!-- The id of the race which this torso belongs to.
	This will almost always be the id of the race in which this type is found (in this case hyena). -->
	<race>dsg_dragon</race>
	
	<!-- The name that will be used when referring to transformations related to this type (such as when changing body parts in the self-TF menu). -->
	<transformationName><![CDATA[龙]]></transformationName>
	
	<!-- The id of the material covering this torso.
	The id will typically take the form of 'innoxia_hyena_fur'.
	Hard-coded values can be found here: https://github.com/Innoxia/liliths-throne-public/blob/dev/src/com/lilithsthrone/game/character/body/coverings/BodyCoveringType.java -->
	<coveringType>dsg_dragon_scales</coveringType>
	
	<!-- The descriptors which should be drawn upon when describing a masculine character's torso of this type.
	Can be left blank. -->
	<descriptorsMasculine/>
	<!-- Same as above, but for feminine characters. -->
	<descriptorsFeminine/>
	<!-- Hyena torsos do not need any racial descriptors, but if you wanted to add some, use this format:
	<descriptorsMasculine>
		<descriptor><![CDATA[hyena-like]]></descriptor>
	</descriptorsMasculine>
	-->
	
	<!-- The description which is shown when a character transforms to obtain this torso type.
	This description immediately follows a brief description of the torso type beginning to transform. -->
	<transformationDescription><![CDATA[
		片刻之后，转化结束，[npc.she]深深地叹了一口气，瘙痒终于停止了，[npc.her]的躯干上布满了龙鳞。[npc.her]的新鳞片在关节周围更加细密，形成的皮也相当坚韧。
		<br/>[npc.Name]现在拥有[style.boldDragon(龙一般)][npc.skinFullDescription]。
	]]></transformationDescription>
	
	<!-- How this torso is described in a character's description page. -->
	<bodyDescription><![CDATA[
		[npc.Her]的躯干具有[npc.a_femininity(true)]的外貌，并且[npc.materialCompositionDescriptor][npc.skinFullDescription(true)]。
	]]></bodyDescription>
	
</torso>
