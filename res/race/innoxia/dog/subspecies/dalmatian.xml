	<applySubspeciesChanges><![CDATA[
		[#targetedBody.getEar().setType(null, EAR_TYPE_DOG_MORPH)]
		
		[#targetedBody.setCovering(npc, BODY_COVERING_TYPE_HUMAN, COVERING_PATTERN_NONE, COVERING_MODIFIER_SMOOTH, COLOUR_SKIN_PALE, false, COLOUR_SKIN_PALE, false)]
		[#targetedBody.setCovering(npc, BODY_COVERING_TYPE_HAIR_HUMAN, COVERING_PATTERN_SPOTTED, COVERING_MODIFIER_SMOOTH, COLOUR_COVERING_WHITE, false, COLOUR_COVERING_BLACK, false)]
		[#targetedBody.setCovering(npc, BODY_COVERING_TYPE_BODY_HAIR_HUMAN, COVERING_PATTERN_NONE, COVERING_MODIFIER_COARSE, COLOUR_COVERING_BLACK, false, COLOUR_COVERING_BLACK, false)]
		
		[#targetedBody.setCovering(npc, BODY_COVERING_TYPE_CANINE_FUR, COVERING_PATTERN_SPOTTED, COVERING_MODIFIER_SHORT, COLOUR_COVERING_WHITE, false, COLOUR_COVERING_BLACK, false)]
		[#targetedBody.setCovering(npc, BODY_COVERING_TYPE_HAIR_CANINE_FUR, COVERING_PATTERN_SPOTTED, COVERING_MODIFIER_FURRY, COLOUR_COVERING_WHITE, false, COLOUR_COVERING_BLACK, false)]
		[#targetedBody.setCovering(npc, BODY_COVERING_TYPE_BODY_HAIR_CANINE_FUR, COVERING_PATTERN_NONE, COVERING_MODIFIER_FURRY, COLOUR_COVERING_BLACK, false, COLOUR_COVERING_BLACK, false)]
		[#targetedBody.updateCoverings(true, true, true, true)]
	]]></applySubspeciesChanges>
	<subspeciesWeighting><![CDATA[
		#IF(targetedRace==RACE_DOG_MORPH
			&& targetedBody.getEar().getType()==EAR_TYPE_DOG_MORPH
			&& targetedBody.getCovering(BODY_COVERING_TYPE_CANINE_FUR, true).getPrimaryColour()==COLOUR_COVERING_WHITE
			&& (targetedBody.getCovering(BODY_COVERING_TYPE_CANINE_FUR, true).getSecondaryColour()==COLOUR_COVERING_BLACK || targetedBody.getCovering(BODY_COVERING_TYPE_CANINE_FUR, true).getSecondaryColour()==COLOUR_COVERING_JET_BLACK)
			&& targetedBody.getCovering(BODY_COVERING_TYPE_CANINE_FUR, true).getPattern()==COVERING_PATTERN_SPOTTED)
			160
		#ELSE
			0
		#ENDIF
	]]></subspeciesWeighting>
