<?xml version='1.0' encoding='UTF-8' standalone='no'?>
<weapon>
	<coreAttributes>
		
		<authorTag><![CDATA[在弹巢的一侧刻着细小的字迹，写着“执法者官方分配，DSG铸造厂生产。”]]></authorTag>
	
		<value>5600</value> 
		
		<melee>false</melee>
		
		<twoHanded>true</twoHanded>
		
		<determiner><![CDATA[一把]]></determiner>
		
		<name><![CDATA[转轮镇定剂步枪]]></name>
		
		<namePlural pluralByDefault="false"><![CDATA[转轮镇定剂步枪]]></namePlural> 
		
		<description><![CDATA[使用装有镇定剂的穿透灵气鳍型飞镖弹步枪，这把步枪并不是真正的狙击武器，它只是为了扩大标准执法者小队的攻击范围而装备，与其他的飞镖弹步枪不同，它使用六发转轮弹巢供弹。]]></description> 
		
		<attackDescriptor><![CDATA[射击]]></attackDescriptor>
		
		<attackTooltipDescription><![CDATA[用你的镇定剂步枪射向[npc2.name]。]]></attackTooltipDescription>
		
		<rarity>EPIC</rarity> 
		
		<equipText><![CDATA[[npc.Name]掏出步枪，装上新的气瓶，并在供弹具里插入能容下六个飞镖的弹巢。]]></equipText>
		
		<unequipText><![CDATA[[npc.Name]把未用完的飞镖从填弹具移除，卸下气瓶，把步枪收起来。]]></unequipText>
		
		<imageName>trqrifle_nogas.svg</imageName> 
		
		<imageEquippedName>trqrifle.svg</imageEquippedName>
		
		<damage>45</damage> 
		
		<arcaneCost>4</arcaneCost> 
		
		<damageVariance>LOW</damageVariance> 
		
		<availableDamageTypes>
			<damageType>POISON</damageType>
		</availableDamageTypes>
		
		<spells/>
		
		<effects/>
		
		<extraEffects>
			<effect><![CDATA[暴击附带[style.boldPoison(“奥术二元”)]效果。]]></effect>
		</extraEffects>
		
		<onHitEffect/>
		
		<onCriticalHitEffect><![CDATA[
		#IF !npc2.hasStatusEffect(SE_ARCANE_DUALITY_NEGATIVE)
		#THEN [##npc2.addStatusEffect(SE_ARCANE_DUALITY_NEGATIVE, 6)]眼睑明显变重时，[npc2.Name][style.boldPoison(努力保护[npc2.herself])]。
		#ENDIF
		]]></onCriticalHitEffect>
		
		<primaryColours values="JUST_BLACK"/> 
		<primaryColoursDye values="ALL_WITH_METALS"/>
		<secondaryColours values="JUST_GREY"/>
		<secondaryColoursDye values="ALL_WITH_METALS"/>
		<tertiaryColours>
			<colour>CLOTHING_GUNMETAL</colour>
		</tertiaryColours>
		<tertiaryColoursDye values="ALL_METAL"/>
		
		<itemTags>
			<tag>CONTRABAND_HEAVY</tag>
			<tag>WEAPON_FIREARM</tag>
		</itemTags>
		
	</coreAttributes>

	<hitDescriptions>
		<hitText><![CDATA[
		[npc.Name]用瞄准镜对准[npc2.name]，扣动了扳机。飞镖末端的针嵌入[npc2.namePos]的灵气中，并释放其内含物。
		]]></hitText>
	</hitDescriptions>

	<missDescriptions>
		<missText><![CDATA[
		[npc.Name]用瞄准镜对准[npc2.name]，扣动了扳机。射偏了！飞镖无用地掉在地面，哗啦哗啦直响。
		]]></missText>
	</missDescriptions>
	
</weapon>
