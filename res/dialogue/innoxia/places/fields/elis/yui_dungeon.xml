			</response>
			<!-- More sex scenes: -->
			<response>
				<availabilityConditional><![CDATA[[#game.isHourBetween(12, 5)]]]></availabilityConditional>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[恢复]]></responseTitle>
				<responseTooltip><![CDATA[
					你只有片刻喘息时间，很快就会有另一个客户到来……
					<br/>[style.italicsSex(继续体验被唯的客户们轮番侵犯的性爱场景。)]
