			</response>
		</responses>
	</scene>
	
	<scene id="amazon_camp_remind_her">
		<preParsingEffects><![CDATA[
			[#game.appendToTextEndStringBuilder(pc.setQuestProgress(QUEST_LINE_SIDE_LUNEXIS_ESCAPE, QUEST_SIDE_UTIL_COMPLETE))]
