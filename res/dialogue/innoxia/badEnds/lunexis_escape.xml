			</response>
		</responses>
	</scene>
	
	<scene id="teleported_blowjob">
		<preParsingEffects><![CDATA[
			[#meraxis.unequipAllClothingIntoVoid(true, true)]
			[#lunexis.applyCollar(meraxis)]
		]]></preParsingEffects>
		<content folderPath="txt/badEnds/lunexis_escape">TELEPORTED_BLOWJOB</content>
