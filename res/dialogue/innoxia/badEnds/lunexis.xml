					#ELSE
						那个曾经是亚马逊人女王的鸡巴套就在你旁边，你可以看向对面，看看她成了什么样子。
					#ENDIF
				]]></responseTooltip>
				<nextDialogue><![CDATA[
					#IF(flags.hasFlag(FLAG_innoxia_themiscyra_bad_end_spectate_ursa))
						null
					#ELSE
						innoxia_badEnds_lunexis_plaza_bad_end_final_spectate
