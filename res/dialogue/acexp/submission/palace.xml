                <responseTabIndex><![CDATA[0]]></responseTabIndex>
                <index><![CDATA[2]]></index>
                <responseTitle><![CDATA[赞美]]></responseTitle>
                <responseTooltip><![CDATA[
                    称赞伊丽莎白的钢琴技艺。
					<br/><i>如果你
					#IF(pc.getAttributeValue(ATTRIBUTE_MAJOR_ARCANE)>=50)
						[style.italicsGood(精通奥术)]
					#ELSE
						[style.italicsBad(精通奥术)]
					#ENDIF
					或者在之前的世界里是
					#IF(pc.hasTraitActivated(PERK_JOB_MUSICIAN))
						[style.italicsGood(一位钢琴家)]
					#ELSE
						[style.italicsBad(一位钢琴家)]
