				[#elizabeth.setCharacterReactedToPregnancy(pc, true)]
			#ENDIF
			[#flags.setFlag(FLAG_acexp_elizabeth_introduced, true)]
			[#flags.setFlag(FLAG_acexp_elizabeth_daily_meeting, true)]
