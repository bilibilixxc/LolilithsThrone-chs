	<displacementText slot="HAIR" type="REMOVE_OR_EQUIP">
		<self><![CDATA[
		[npc.Name]将发带从[npc.her][npc.hairSkin+]上取下。
]]></self>
		<other><![CDATA[
[npc.her]将[npc.her][npc2.hairSkin+]从发带中拉出来。
]]></other>
		<otherRough><![CDATA[
[npc.her]将[npc2.namePos][npc2.hairSkin+]从发带中拽出来。
]]></otherRough>
	</displacementText>
	<replacementText slot="HAIR" type="REMOVE_OR_EQUIP">
		<self><![CDATA[
[npc.Name]聚集起[npc.her][npc.hairSkin+]，然后把它穿过发圈。
]]></self>
		<other><![CDATA[
[npc.Name]聚集起[npc2.namePos][npc2.hairSkin+]，然后把它穿过发圈。
]]></other>
		<otherRough><![CDATA[
[npc.Name]收拾起[npc2.NamePos][npc2.hairSkin+]，然后将它穿过发带。
]]></otherRough>
	</replacementText>
	
	<displacementText slot="TAIL" type="REMOVE_OR_EQUIP">
		<self><![CDATA[
[npc.her]将发带从[npc.her][npc.tail+]上摘下。
]]></self>
		<other><![CDATA[
[npc.her]将发带从[npc2.namePos][npc2.tail+]上摘下。
