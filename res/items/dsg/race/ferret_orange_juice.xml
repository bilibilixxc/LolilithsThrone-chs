<?xml version='1.0' encoding='UTF-8' standalone='no'?>
<item>
	<coreAttributes>
		<authorTag><![CDATA[罐子底下刻着细小的字迹，写着“DSG食品有限公司制罐”。]]></authorTag>
		
		<value>15</value> 
		<determiner><![CDATA[一罐]]></determiner>
		<name><![CDATA[橘子碳酸果汁]]></name>
		<namePlural pluralByDefault="false"><![CDATA[橘子碳酸果汁]]></namePlural>
		<description><![CDATA[一罐碳酸橙汁。标签上画着一只雪貂男缠绕在橙树的树枝上，伸展他的长身去够果实。]]></description> 
		
		<useDescriptor><![CDATA[喝]]></useDescriptor>
		
		<sexUse>true</sexUse>
		<combatUseAllies>true</combatUseAllies>
		<combatUseEnemies>false</combatUseEnemies>
		<consumedOnUse>true</consumedOnUse>
		
		<rarity>UNCOMMON</rarity> 
		
		<imageName zLayer="0" imageRotation="0" imageSize="100">background_bottom.svg</imageName>
		<imageName zLayer="1" imageRotation="-15" imageSize="80">ferret_orange_juice.svg</imageName>
		<imageName zLayer="2" imageRotation="0" imageSize="100">background_top.svg</imageName>
		
		<colourPrimary>ATTRIBUTE_ARCANE</colourPrimary>
		<colourSecondary/>
		<colourTertiary/>
		
		<enchantmentItemTypeId>POTION</enchantmentItemTypeId>
		<enchantmentEffectId>ATTRIBUTE_ARCANE</enchantmentEffectId>
		
		<effectTooltipLines>
			<line><![CDATA[[#ATTRIBUTE_HEALTH_MAXIMUM.getFormattedValue(2)]到“药剂效果”]]></line>
			<line><![CDATA[[#ATTRIBUTE_HEALTH_MAXIMUM.getFormattedValue(2)]到“药剂效果”]]></line>
		</effectTooltipLines>
		
		<applyEffects><![CDATA[
			[##npc.incrementMana(npc.getAttributeValue(ATTRIBUTE_MANA_MAXIMUM)/10)]
			
			<p style='margin-bottom:0; padding-bottom:0;'>
				一道振奋人心的奥术能量浪潮席卷了[npc.name]……
			</p>
			[#npc.addPotionEffect(ATTRIBUTE_HEALTH_MAXIMUM, 2)]
		]]></applyEffects>
		
		<itemTags>
			<tag>DRINK</tag>
			<tag>ATTRIBUTE_TF_ITEM</tag>
			<tag>SOLD_BY_RALPH</tag>
		</itemTags>
	</coreAttributes>

	<useDescriptions>
		<selfUse><![CDATA[
		打开汽水后，[npc.name]将罐装的橙汁汽水带到[npc.her]的嘴边。新鲜柑橘水果和气泡的气味从罐口升腾而起，当[npc.she]仰起头开始喝这股微微刺激的液体时，[npc.she]感到自己焕然一新。
		]]></selfUse>
		<otherUse><![CDATA[
		打开汽水后，[npc.name]将罐装的橙汁汽水带到[npc2.namePos]等待[npc2.lips]边。新鲜的柑橘水果和气泡的气味从罐口升腾而起，当[npc2.she]仰起头开始喝这股微微刺激的液体时，[npc.she]感到自己焕然一新。
		]]></otherUse>
	</useDescriptions>

	
</item>
