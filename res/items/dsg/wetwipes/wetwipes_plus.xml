	<useDescriptions>
		<selfUse><![CDATA[[npc.Name]撕开箔纸包装袋，取出湿巾，然后迅速用它清洁[npc.herself]。
]]></selfUse>
		<otherUse><![CDATA[[npc.Name]撕开箔纸包装袋，取出湿巾，然后迅速用它清洁[npc2.name]。
]]></otherUse>
