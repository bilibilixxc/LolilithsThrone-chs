<?xml version='1.0' encoding='UTF-8' standalone='no'?>
<item>
	<coreAttributes>
		<value>150</value> 
		<determiner><![CDATA[一瓶]]></determiner>
		<name><![CDATA[冰茶]]></name>
		<namePlural pluralByDefault="false"><![CDATA[冰茶]]></namePlural>
		<description><![CDATA[金属保温瓶中装有冰块和薄荷茶。瓶子侧面的贴纸声称，这种饮料是炎炎夏日的最佳清凉饮料。贴纸上还描绘了一个满头大汗的霜冻蝾螈女正在用一个类似的瓶子喝水。]]></description> 
		<useDescriptor><![CDATA[饮品]]></useDescriptor>
		<sexUse>true</sexUse>
		<combatUseAllies>true</combatUseAllies>
		<combatUseEnemies>false</combatUseEnemies>
		<consumedOnUse>true</consumedOnUse>
		
		<rarity>UNCOMMON</rarity> 
		
		<!-- There is a fully commented example of this in 'hyena_bone_crunchers.xml' -->
		<imageName zLayer="0" imageRotation="0" imageSize="100">background_bottom.svg</imageName>
		<imageName zLayer="1" imageRotation="-15" imageSize="80">salamander_insulated_bottle.svg</imageName>
		<imageName zLayer="2" imageRotation="0" imageSize="100">background_top.svg</imageName>
		
		<colourPrimary>ATTRIBUTE_PHYSIQUE</colourPrimary>
		<colourSecondary>mintychip_salamanderFrost</colourSecondary>
		<colourTertiary>CLOTHING_STEEL</colourTertiary>
		
		<enchantmentItemTypeId>POTION</enchantmentItemTypeId>
		<enchantmentEffectId>ATTRIBUTE_PHYSIQUE</enchantmentEffectId>
		
		<effectTooltipLines>
			<line><![CDATA[[style.boldGood(回复)]5%[style.boldMana([#ATTRIBUTE_MANA_MAXIMUM.getName()])]]]></line>
			<line><![CDATA[[#ATTRIBUTE_RESISTANCE_FIRE.getFormattedValue(5)]到“药剂效果”]]></line>
		</effectTooltipLines>
		
		<applyEffects><![CDATA[
			[##npc.incrementMana(npc.getAttributeValue(ATTRIBUTE_MANA_MAXIMUM)/20)]
			
			<p style='margin-bottom:0; padding-bottom:0;'>
				一股冰冷的奥术能量浪潮席卷了[npc.name]……
			</p>
			[#npc.addPotionEffect(ATTRIBUTE_RESISTANCE_FIRE, 5)]
		]]></applyEffects>
		
		<itemTags>
			<tag>DRINK</tag>
			<tag>ATTRIBUTE_TF_ITEM</tag>
			<tag>SOLD_BY_RALPH</tag>
		</itemTags>
	</coreAttributes>

	<useDescriptions>
		<selfUse><![CDATA[
		在拧开瓶盖后，[npc.name]将冷茶瓶端到[npc.her]的[npc.mouth]边。[npc.She]高兴地发现标签并没有夸大它的清凉，迅速地喝下了这杯薄荷饮料。
		]]></selfUse>
		<otherUse><![CDATA[
		在拧开瓶盖后，[npc.name]将冷茶瓶端到[npc2.namePos]等待[npc2.lips]边。[npc2.name]高兴地发现标签并没有夸大它的清凉，迅速地喝下了这杯薄荷饮料。
		]]></otherUse>
	</useDescriptions>
</item>
