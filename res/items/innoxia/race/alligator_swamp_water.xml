<?xml version='1.0' encoding='UTF-8' standalone='no'?>
<item>
	<coreAttributes>
		<value>40</value> 
		<determiner><![CDATA[一瓶]]></determiner>
		<name><![CDATA[沼泽水]]></name>
		<namePlural pluralByDefault="false"><![CDATA[沼泽水]]></namePlural>
		<description><![CDATA[一个坚固的玻璃瓶，里面装的似乎是某种私酿烈酒。标签上画着鳄男正被鳄女嘴对嘴喂药，并从瓶子里喝水，那瓶子和你手上这个一模一样。]]></description> 
		
		<useDescriptor><![CDATA[喝]]></useDescriptor>
		
		<sexUse>true</sexUse>
		<combatUseAllies>true</combatUseAllies>
		<combatUseEnemies>false</combatUseEnemies>
		<consumedOnUse>true</consumedOnUse>
		
		<rarity>UNCOMMON</rarity> 
		
		<imageName zLayer="0" imageRotation="0" imageSize="100">background_bottom.svg</imageName>
		<imageName zLayer="1" imageRotation="-15" imageSize="80">alligator_swamp_water.svg</imageName>
		<imageName zLayer="2" imageRotation="0" imageSize="100">background_top.svg</imageName>
		
		<colourPrimary>ATTRIBUTE_PHYSIQUE</colourPrimary>
		<colourSecondary/>
		<colourTertiary/>
		
		<enchantmentItemTypeId>POTION</enchantmentItemTypeId>
		<enchantmentEffectId>ATTRIBUTE_PHYSIQUE</enchantmentEffectId>
		
		<effectTooltipLines>
			<line><![CDATA[[style.boldGood(回复)]5%[style.boldHealth([#ATTRIBUTE_HEALTH_MAXIMUM.getName()])]]]></line>
			<line><![CDATA[[#ATTRIBUTE_MAJOR_PHYSIQUE.getFormattedValue(1)]到“药剂效果”]]></line>
			<line><![CDATA[[style.boldMinorBad(增加)]75%[style.boldAlcohol(醉酒度)]]]></line>
		</effectTooltipLines>
		
		<applyEffects><![CDATA[
			[##npc.incrementHealth(npc.getAttributeValue(ATTRIBUTE_HEALTH_MAXIMUM)/20)]
			
			<p style='margin-bottom:0; padding-bottom:0;'>
				一股强大的奥术能量浪潮席卷了[npc.name]……
			</p>
			[#npc.addPotionEffect(ATTRIBUTE_MAJOR_PHYSIQUE, 1)]
			[#npc.incrementAlcoholLevel(0.75)]
		]]></applyEffects>
		
		<itemTags>
			<tag>DRINK</tag>
			<tag>ALCOHOLIC</tag>
			<tag>SUBMISSION_TUNNEL_SPAWN</tag>
			<tag>ATTRIBUTE_TF_ITEM</tag>
			<tag>SOLD_BY_RALPH</tag>
		</itemTags>
	</coreAttributes>

	<useDescriptions>
		<selfUse><![CDATA[
		从沼泽水瓶子中拔出塞子后，[npc.name]大口喝下了这瓶极高度酒精含量的月光私酿酒。强烈、浓重的味道非常美味，[npc.name]不禁贪婪地将整瓶酒一饮而尽，留下一股奇怪而辛辣的余味挥之不去在[npc.tongue+]上。
		]]></selfUse>
		<otherUse><![CDATA[
		从沼泽水瓶子中拔出塞子后，[npc.name]将这瓶极高度酒精含量的月光酒送到[npc2.namePos]等待[npc2.lips]边并让[npc2.herHim]喝。强烈、浓烈的味道非常美味，[npc2.name]不禁贪婪地将整瓶酒一饮而尽，留下一股奇怪而辛辣的余味挥之不去在[npc2.her][npc2.tongue+]上。
		]]></otherUse>
	</useDescriptions>

	
</item>
