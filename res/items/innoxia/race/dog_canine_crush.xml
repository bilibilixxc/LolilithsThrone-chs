<?xml version='1.0' encoding='UTF-8' standalone='no'?>
<item>
	<coreAttributes>
		<value>35</value> 
		<determiner><![CDATA[一瓶]]></determiner>
		<name><![CDATA[犬根宝]]></name>
		<namePlural pluralByDefault="false"><![CDATA[犬根宝]]></namePlural>
		<description><![CDATA[一瓶看起来像啤酒的一瓶饮品。前面的标签上画着一个漂亮的犬娘四肢着地并展现着她的裸体，将湿淋淋的小穴抵在一个纯狗男勃起的有结的肉棒上。]]></description> 
		
		<useDescriptor><![CDATA[喝]]></useDescriptor>
		
		<sexUse>true</sexUse>
		<combatUseAllies>true</combatUseAllies>
		<combatUseEnemies>false</combatUseEnemies>
		<consumedOnUse>true</consumedOnUse>
		
		<rarity>UNCOMMON</rarity> 
		
		<imageName zLayer="0" imageRotation="0" imageSize="100">background_bottom.svg</imageName>
		<imageName zLayer="1" imageRotation="-15" imageSize="80">dog_canine_crush.svg</imageName>
		<imageName zLayer="2" imageRotation="0" imageSize="100">background_top.svg</imageName>
		
		<colourPrimary>ATTRIBUTE_PHYSIQUE</colourPrimary>
		<colourSecondary/>
		<colourTertiary/>
		
		<enchantmentItemTypeId>POTION</enchantmentItemTypeId>
		<enchantmentEffectId>ATTRIBUTE_PHYSIQUE</enchantmentEffectId>
		
		<effectTooltipLines>
			<line><![CDATA[[style.boldGood(回复)]5%[style.boldHealth([#ATTRIBUTE_HEALTH_MAXIMUM.getName()])]]]></line>
			<line><![CDATA[[#ATTRIBUTE_MAJOR_PHYSIQUE.getFormattedValue(1)]到“药剂效果”]]></line>
			<line><![CDATA[[style.boldMinorBad(增加)]5%[style.boldAlcohol(醉酒度)]]]></line>
		</effectTooltipLines>
		
		<applyEffects><![CDATA[
			[##npc.incrementHealth(npc.getAttributeValue(ATTRIBUTE_HEALTH_MAXIMUM)/20)]
			
			<p style='margin-bottom:0; padding-bottom:0;'>
				一股丝滑的奥术能量浪潮席卷了[npc.name]……
			</p>
			[#npc.addPotionEffect(ATTRIBUTE_MAJOR_PHYSIQUE, 1)]
			[#npc.incrementAlcoholLevel(0.05)]
		]]></applyEffects>
		
		<itemTags>
			<tag>DRINK</tag>
			<tag>ALCOHOLIC</tag>
			<tag>DOMINION_ALLEYWAY_SPAWN</tag>
			<tag>ATTRIBUTE_TF_ITEM</tag>
			<tag>SOLD_BY_RALPH</tag>
		</itemTags>
	</coreAttributes>

	<useDescriptions>
		<selfUse><![CDATA[
		[npc.Name]起开犬根宝瓶子的盖子，然后将它举到[npc.her]等待[npc.lips]边并立刻喝下整瓶。尽管味道像一种普通的啤酒，但留下一股奇怪的雄性余味挥之不去在[npc.namePos][npc.tongue]上。
		]]></selfUse>
		<otherUse><![CDATA[
		[npc.Name]起开犬根宝瓶子的盖子，然后将它举到[npc2.namePos]等待[npc2.lips]边并让[npc2.her]喝下整瓶。尽管味道像一种普通的啤酒，但留下一股奇怪的雄性余味挥之不去在[npc2.namePos]的[npc2.tongue]上。
		]]></otherUse>
	</useDescriptions>

	
</item>
