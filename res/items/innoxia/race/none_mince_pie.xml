<?xml version='1.0' encoding='UTF-8' standalone='no'?>
<item>
	<coreAttributes>
		<value>15</value> 
		<determiner><![CDATA[一块]]></determiner>
		<name><![CDATA[甜馅饼]]></name>
		<namePlural pluralByDefault="false"><![CDATA[甜馅饼]]></namePlural>
		<description><![CDATA[一个甜馅饼，馅料是干果和香料的混合物。奇怪的是，馅饼的触感似乎始终保持温热，这说明馅饼上一定被施了某种魔法。]]></description> 
		
		<useDescriptor><![CDATA[吃]]></useDescriptor>
		
		<sexUse>true</sexUse>
		<combatUseAllies>true</combatUseAllies>
		<combatUseEnemies>false</combatUseEnemies>
		<consumedOnUse>true</consumedOnUse>
		
		<rarity>UNCOMMON</rarity> 
		
		<imageName zLayer="0" imageRotation="0" imageSize="100">background_bottom.svg</imageName>
		<imageName zLayer="1" imageRotation="0" imageSize="80">none_mince_pie.svg</imageName>
		<imageName zLayer="2" imageRotation="0" imageSize="100">background_top.svg</imageName>
		
		<colourPrimary>GENERIC_SEX</colourPrimary>
		<colourSecondary/>
		<colourTertiary/>
		
		<enchantmentItemTypeId>POTION</enchantmentItemTypeId>
		<enchantmentEffectId>ATTRIBUTE_SEXUAL</enchantmentEffectId>
		
		<effectTooltipLines>
			<line><![CDATA[[style.boldGood(回复)]10%[style.boldHealth([#ATTRIBUTE_HEALTH_MAXIMUM.getName()])]]]></line>
			<line><![CDATA[[#ATTRIBUTE_DAMAGE_LUST.getFormattedValue(1)]到“药剂效果”]]></line>
			<line><![CDATA[[#ATTRIBUTE_DAMAGE_FIRE.getFormattedValue(1)]到“药剂效果”]]></line>
		</effectTooltipLines>
		
		<applyEffects><![CDATA[
			[##npc.incrementHealth(npc.getAttributeValue(ATTRIBUTE_HEALTH_MAXIMUM)/10)]
			
			<p style='margin-bottom:0; padding-bottom:0;'>
				一股温暖的奥术能量浪潮席卷了[npc.name]……
			</p>
			[#npc.addPotionEffect(ATTRIBUTE_DAMAGE_LUST, 1)]
			[#npc.addPotionEffect(ATTRIBUTE_DAMAGE_FIRE, 1)]
		]]></applyEffects>
		
		<itemTags>
			<tag>FOOD</tag>
			<tag>REINDEER_GIFT</tag>
			<tag>ATTRIBUTE_TF_ITEM</tag>
			<tag>SOLD_BY_RALPH</tag>
		</itemTags>
	</coreAttributes>

	<useDescriptions>
		<selfUse><![CDATA[
		[npc.Name]将魔法甜馅饼送到[npc.her]的嘴边，然后小心翼翼地咬了一口。温暖的、香料调味的水果馅料实在太美味了，让[npc.herHim]贪婪地狼吞虎咽地吃下整个馅饼。
		]]></selfUse>
		<otherUse><![CDATA[
		[npc.Name]将魔法甜馅饼送到[npc2.namePos]的嘴边，然后鼓励[npc2.herHim]尝试一口。温暖的、香料调味的水果馅料原来非常美味，让[npc2.name]急切地狼吞虎咽地吃下了整个馅饼。
		]]></otherUse>
	</useDescriptions>

	
</item>
