<?xml version='1.0' encoding='UTF-8' standalone='no'?>
<item>
	<coreAttributes>
		<value>45</value> 
		<determiner><![CDATA[一罐]]></determiner>
		<name><![CDATA[猛禽能量饮料]]></name>
		<namePlural pluralByDefault="false"><![CDATA[猛禽能量饮料]]></namePlural>
		<description><![CDATA[一罐色彩鲜艳的猛禽牌咖啡因能量饮料。反面标签上有一幅图案，一个眼神狂野的鹰女把一个胆小的兔男按倒在地，然后骑在他的肉棒上。]]></description> 
		
		<useDescriptor><![CDATA[喝]]></useDescriptor>
		
		<sexUse>true</sexUse>
		<combatUseAllies>true</combatUseAllies>
		<combatUseEnemies>false</combatUseEnemies>
		<consumedOnUse>true</consumedOnUse>
		
		<rarity>UNCOMMON</rarity> 
		
		<imageName zLayer="0" imageRotation="0" imageSize="100">background_bottom.svg</imageName>
		<imageName zLayer="1" imageRotation="-15" imageSize="80">raptor_energy_drink.svg</imageName>
		<imageName zLayer="2" imageRotation="0" imageSize="100">background_top.svg</imageName>
		
		<colourPrimary>ATTRIBUTE_PHYSIQUE</colourPrimary>
		<colourSecondary/>
		<colourTertiary/>
		
		<enchantmentItemTypeId>POTION</enchantmentItemTypeId>
		<enchantmentEffectId>ATTRIBUTE_PHYSIQUE</enchantmentEffectId>
		
		<effectTooltipLines>
			<line><![CDATA[[#ATTRIBUTE_HEALTH_MAXIMUM.getFormattedValue(5)]到“药剂效果”]]></line>
			<line><![CDATA[[#ATTRIBUTE_CRITICAL_DAMAGE.getFormattedValue(5)]到“药剂效果”]]></line>
		</effectTooltipLines>
		
		<applyEffects><![CDATA[
			<p style='margin-bottom:0; padding-bottom:0;'>
				一股强大的能量冲击涌进[npc.namePos]的身体！
			</p>
			[#npc.addPotionEffect(ATTRIBUTE_HEALTH_MAXIMUM, 5)]
			[#npc.addPotionEffect(ATTRIBUTE_CRITICAL_DAMAGE, 5)]
		]]></applyEffects>
		
		<itemTags>
			<tag>DRINK</tag>
			<tag>DOMINION_ALLEYWAY_SPAWN</tag>
			<tag>ELIS_ALLEYWAY_SPAWN</tag>
			<tag>ATTRIBUTE_TF_ITEM</tag>
			<tag>SOLD_BY_RALPH</tag>
			<tag>CAFFEINATED_025</tag>
		</itemTags>
	</coreAttributes>

	<useDescriptions>
		<selfUse><![CDATA[
			打开瓶盖后，[npc.name]把猛禽能量饮料的罐子送到[npc.her]的嘴边。从罐口升起一股甜美的、人工的气味，当[npc.she]仰起头，开始喝这气泡丰富的液体时，[npc.she]很快发现到自己充满了能量。
		]]></selfUse>
		<otherUse><![CDATA[
			打开瓶盖后，[npc.name]把猛禽能量饮料的罐子送到[npc2.namePos]等待[npc2.lips]前。从罐口升起一股甜美的、人工的气味，当[npc2.name]仰起头，开始喝这气泡丰富的液体时，[npc2.she]很快发现到自己充满了能量。
		]]></otherUse>
	</useDescriptions>

</item>
