<?xml version='1.0' encoding='UTF-8' standalone='no'?>
<item>
	<coreAttributes>
		<value>80</value> 
		<determiner><![CDATA[一包]]></determiner>
		<name><![CDATA[连骨肉]]></name>
		<namePlural pluralByDefault="false"><![CDATA[连骨肉]]></namePlural>
		<description><![CDATA[一包“连骨肉”，包括一块某种生肉，用防油纸包裹，再用棕色绳子捆起来。]]></description> 
		
		<useDescriptor><![CDATA[吃]]></useDescriptor>
		
		<sexUse>true</sexUse>
		<combatUseAllies>true</combatUseAllies>
		<combatUseEnemies>false</combatUseEnemies>
		<consumedOnUse>true</consumedOnUse>
		
		<rarity>RARE</rarity> 
		
		<imageName zLayer="0" imageRotation="0" imageSize="100">background_bottom.svg</imageName>
		<imageName zLayer="1" imageRotation="0" imageSize="70" target1="stroke=&quot;#000&quot;" replacement1="stroke=&quot;#ff5555&quot;" target2="#ff8080" replacement2="#ff5555">res/race/innoxia/wolf/subspecies/icon.svg</imageName>
		<imageName zLayer="2" imageRotation="0" imageSize="70">wolf_meat_and_marrow.svg</imageName>
		<imageName zLayer="3" imageRotation="0" imageSize="100">background_top.svg</imageName>
		
		<colourPrimary>RACE_WOLF_MORPH</colourPrimary>
		<colourSecondary/>
		<colourTertiary/>
		
		<potionDescriptor><![CDATA[狼]]></potionDescriptor>
		<associatedRace>WOLF_MORPH</associatedRace>
		<enchantmentItemTypeId>ELIXIR</enchantmentItemTypeId>
		<enchantmentEffectId>RACE</enchantmentEffectId>
		
		<effectTooltipLines>
			<line><![CDATA[[style.boldGood(回复)]10%[style.boldHealth([#ATTRIBUTE_HEALTH_MAXIMUM.getName()])]]]></line>
			<line><![CDATA[[#ATTRIBUTE_MAJOR_PHYSIQUE.getFormattedValue(5)]到“药剂效果”]]></line>
			<line><![CDATA[如果肌肉等级比[style.colourMuscleThree(“肌肉紧致”)]低，则增加1级肌肉等级]]></line>
		</effectTooltipLines>
		
		<applyEffects><![CDATA[
			[##npc.incrementHealth(npc.getAttributeValue(ATTRIBUTE_HEALTH_MAXIMUM)/10)]
			
			<p style='margin-bottom:0; padding-bottom:0;'>
				[npc.Name]开始感到更加强壮……
			</p>
			[#npc.addPotionEffect(ATTRIBUTE_MAJOR_PHYSIQUE, 5)]
			#IF(npc.getMuscleValue()<60)
				[#npc.incrementMuscle(1)]
			#ENDIF
		]]></applyEffects>
		
		<itemTags>
			<tag>FOOD</tag>
			<tag>DOMINION_ALLEYWAY_SPAWN</tag>
			<tag>ELIS_ALLEYWAY_SPAWN</tag>
			<tag>RACIAL_TF_ITEM</tag>
			<tag>SOLD_BY_RALPH</tag>
		</itemTags>
	</coreAttributes>

	<useDescriptions>
		<selfUse><![CDATA[
		[npc.Name]解开包裹的褐色绳子，剥开防油纸后，将现在暴露在外的连骨肉送到[npc.her]嘴里。一股浓烈的血腥气味扑鼻而来，[npc.she]发现[npc.herself]一想到要吃生肉就开始不停的流口水了。[npc.she]贪婪地撕咬下淌血的肉块，迅速吃完后，用舌头舔净了[npc.her]的手指。
		]]></selfUse>
		<otherUse><![CDATA[
		[npc.Name]解开包裹的褐色绳子，剥开防油纸后，将现在暴露在外的连骨肉送到[npc2.namePos]口中。一股浓烈的血腥气味扑鼻而来，[npc2.she]发现[npc2.herself]一想到要吃生肉就不停地流口水了。[npc2.she]贪婪地撕咬下淌血的肉块，迅速吃完后，用舌头舔净了[npc2.her]手指。
		]]></otherUse>
	</useDescriptions>

	
</item>
