<?xml version='1.0' encoding='UTF-8' standalone='no'?>
<item>
	<coreAttributes>
		<value>150</value> 
		<determiner><![CDATA[一瓶]]></determiner>
		<name><![CDATA[猫猫幻想]]></name>
		<namePlural pluralByDefault="false"><![CDATA[猫猫幻想]]></namePlural>
		<description><![CDATA[一只精致的玻璃瓶，里面装满了浓稠的、像奶油一样的液体。瓶子正面的标签上画着一对猫娘亲吻彼此，其中掌握主动的猫娘的手伸向了她的伴侣的腿间。]]></description> 
		
		<useDescriptor><![CDATA[喝]]></useDescriptor>
		
		<sexUse>true</sexUse>
		<combatUseAllies>true</combatUseAllies>
		<combatUseEnemies>false</combatUseEnemies>
		<consumedOnUse>true</consumedOnUse>
		
		<rarity>UNCOMMON</rarity> 
		
		<imageName zLayer="0" imageRotation="0" imageSize="100">background_bottom.svg</imageName>
		<imageName zLayer="1" imageRotation="-15" imageSize="80">cat_felines_fancy.svg</imageName>
		<imageName zLayer="2" imageRotation="0" imageSize="100">background_top.svg</imageName>
		
		<colourPrimary>ATTRIBUTE_ARCANE</colourPrimary>
		<colourSecondary/>
		<colourTertiary/>
		
		<enchantmentItemTypeId>POTION</enchantmentItemTypeId>
		<enchantmentEffectId>ATTRIBUTE_ARCANE</enchantmentEffectId>
		
		<effectTooltipLines>
			<line><![CDATA[[style.boldGood(回复)]5%[style.boldMana([#ATTRIBUTE_MANA_MAXIMUM.getName()])]]]></line>
			<line><![CDATA[[#ATTRIBUTE_MAJOR_ARCANE.getFormattedValue(1)]到“药剂效果” ]]></line>
			<line><![CDATA[[style.boldMinorBad(增加)]10%[style.boldAlcohol(醉酒度)]]]></line>
		</effectTooltipLines>
		
		<applyEffects><![CDATA[
			[##npc.incrementMana(npc.getAttributeValue(ATTRIBUTE_MANA_MAXIMUM)/20)]
			
			<p style='margin-bottom:0; padding-bottom:0;'>
				一股清爽的奥术能量浪潮席卷了[npc.name]……
			</p>
			[#npc.addPotionEffect(ATTRIBUTE_MAJOR_ARCANE, 1)]
			[#npc.incrementAlcoholLevel(0.1)]
		]]></applyEffects>
		
		<itemTags>
			<tag>DRINK</tag>
			<tag>ALCOHOLIC</tag>
			<tag>DOMINION_ALLEYWAY_SPAWN</tag>
			<tag>ATTRIBUTE_TF_ITEM</tag>
			<tag>SOLD_BY_RALPH</tag>
		</itemTags>
	</coreAttributes>

	<useDescriptions>
		<selfUse><![CDATA[
		[npc.Name]从猫猫幻想瓶子上旋开盖子，然后把头仰起，把瓶口送到[npc.her]等待[npc.lips]。一股浓郁的奶油香气从瓶口散发出来，当[npc.she]贪婪地灌下凉爽的液体时，[npc.sheIs]发现它的味道完全如同美味的香气所暗示的一样好。
		]]></selfUse>
		<otherUse><![CDATA[
		[npc.Name]从猫猫幻想瓶子上旋开盖子，然后将它送到[npc2.namePos]等待[npc2.lips]边。一股浓郁的奶油香气从瓶口散发出来，当[npc2.she]贪婪地灌下凉爽的液体时，[npc2.sheIs]发现它的味道完全如同美味的香气所暗示的一样好。
		]]></otherUse>
	</useDescriptions>

	
</item>
