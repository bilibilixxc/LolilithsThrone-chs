<?xml version='1.0' encoding='UTF-8' standalone='no'?>
<item>
	<coreAttributes>
		<value>120</value> 
		<determiner><![CDATA[一瓶]]></determiner>
		<name><![CDATA[头狼威士忌]]></name>
		<namePlural pluralByDefault="false"><![CDATA[头狼威士忌]]></namePlural>
		<description><![CDATA[这个玻璃瓶装满了高度含酒精的威士忌，正面的标签上画着一只纯狼男与三只亚狼女做爱的场景。上面的标语写道：“头狼威士忌；献给真正的首领！"。]]></description> 
		
		<useDescriptor><![CDATA[喝]]></useDescriptor>
		
		<sexUse>true</sexUse>
		<combatUseAllies>true</combatUseAllies>
		<combatUseEnemies>false</combatUseEnemies>
		<consumedOnUse>true</consumedOnUse>
		
		<rarity>UNCOMMON</rarity> 
		
		<imageName zLayer="0" imageRotation="0" imageSize="100">background_bottom.svg</imageName>
		<imageName zLayer="1" imageRotation="-15" imageSize="80">wolf_wolf_whiskey.svg</imageName>
		<imageName zLayer="2" imageRotation="0" imageSize="100">background_top.svg</imageName>
		
		<colourPrimary>ATTRIBUTE_PHYSIQUE</colourPrimary>
		<colourSecondary/>
		<colourTertiary/>
		
		<enchantmentItemTypeId>POTION</enchantmentItemTypeId>
		<enchantmentEffectId>ATTRIBUTE_PHYSIQUE</enchantmentEffectId>
		
		<effectTooltipLines>
			<line><![CDATA[[style.boldGood(回复)]5%[style.boldHealth([#ATTRIBUTE_HEALTH_MAXIMUM.getName()])]]]></line>
			<line><![CDATA[[#ATTRIBUTE_MAJOR_PHYSIQUE.getFormattedValue(1)]到“药剂效果”]]></line>
			<line><![CDATA[[style.boldMinorBad(增加)]40%[style.boldAlcohol(醉酒度)]]]></line>
		</effectTooltipLines>
		
		<applyEffects><![CDATA[
			[##npc.incrementHealth(npc.getAttributeValue(ATTRIBUTE_HEALTH_MAXIMUM)/20)]
			
			<p style='margin-bottom:0; padding-bottom:0;'>
				一股强大的奥术能量浪潮席卷了[npc.name]……
			</p>
			[#npc.addPotionEffect(ATTRIBUTE_MAJOR_PHYSIQUE, 1)]
			[#npc.incrementAlcoholLevel(0.4)]
		]]></applyEffects>
		
		<itemTags>
			<tag>DRINK</tag>
			<tag>ALCOHOLIC</tag>
			<tag>DOMINION_ALLEYWAY_SPAWN</tag>
			<tag>ELIS_ALLEYWAY_SPAWN</tag>
			<tag>ATTRIBUTE_TF_ITEM</tag>
			<tag>SOLD_BY_RALPH</tag>
		</itemTags>
	</coreAttributes>

	<useDescriptions>
		<selfUse><![CDATA[
		[npc.Name]拧开头狼威士忌瓶子的瓶盖，然后仰起头将它送到[npc.her]等待[npc.lips]前。一股浓郁的雄性气味从瓶口散发出来，然后[npc.name]大口喝下这液体，发现它的味道几乎与其刺鼻的香气相同。
		]]></selfUse>
		<otherUse><![CDATA[
		[npc.Name]拧开头狼威士忌瓶子的瓶盖，然后将它送到[npc2.namePos]等待[npc2.lips]前。一股浓郁的雄性气味从瓶口散发出来，然后[npc2.name]大口喝下这液体，发现它的味道几乎与其刺鼻的香气相同。
		]]></otherUse>
	</useDescriptions>

	
</item>
