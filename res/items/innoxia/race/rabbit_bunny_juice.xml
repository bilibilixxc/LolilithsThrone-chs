<item>
	<coreAttributes>
		<value>30</value> 
		<determiner><![CDATA[一瓶]]></determiner>
		<name><![CDATA[兔兔果汁]]></name>
		<namePlural pluralByDefault="false"><![CDATA[兔兔果汁]]></namePlural>
		<description><![CDATA[一个小塑料瓶，里面装的似乎是某种胡萝卜汁，标签上写着“兔兔果汁”。标签上有一张相当淫秽的图片，一个兔子女正把一根胡萝卜形状的假阳具塞进自己的小穴里。]]></description> 
		
		<useDescriptor><![CDATA[喝]]></useDescriptor>
		
		<sexUse>true</sexUse>
		<combatUseAllies>true</combatUseAllies>
		<combatUseEnemies>false</combatUseEnemies>
		<consumedOnUse>true</consumedOnUse>
		
		<rarity>UNCOMMON</rarity> 
		
		<imageName zLayer="0" imageRotation="0" imageSize="100">background_bottom.svg</imageName>
		<imageName zLayer="1" imageRotation="-15" imageSize="80">rabbit_bunny_juice.svg</imageName>
		<imageName zLayer="2" imageRotation="0" imageSize="100">background_top.svg</imageName>
		
		<colourPrimary>GENERIC_SEX</colourPrimary>
		<colourSecondary/>
		<colourTertiary/>
		
		<enchantmentItemTypeId>POTION</enchantmentItemTypeId>
		<enchantmentEffectId>ATTRIBUTE_SEXUAL</enchantmentEffectId>
		
		<effectTooltipLines>
			<line><![CDATA[[#ATTRIBUTE_FERTILITY.getFormattedValue(5)]到“药剂效果”]]></line>
			<line><![CDATA[[#ATTRIBUTE_VIRILITY.getFormattedValue(5)]到“药剂效果”]]></line>
			<line><![CDATA[[#ATTRIBUTE_RESISTANCE_LUST.getFormattedValue(-10)]到“药剂效果”]]></line>
		</effectTooltipLines>
		
		<applyEffects><![CDATA[
			<p style='margin-bottom:0; padding-bottom:0;'>
				一股温暖的奥术能量浪潮席卷了[npc.name]……
			</p>
			[#npc.addPotionEffect(ATTRIBUTE_FERTILITY, 5)]
			[#npc.addPotionEffect(ATTRIBUTE_VIRILITY, 5)]
			[#npc.addPotionEffect(ATTRIBUTE_RESISTANCE_LUST, -10)]
		]]></applyEffects>
		
		<itemTags>
			<tag>DRINK</tag>
			<tag>DOMINION_ALLEYWAY_SPAWN</tag>
			<tag>ELIS_ALLEYWAY_SPAWN</tag>
			<tag>ATTRIBUTE_TF_ITEM</tag>
			<tag>SOLD_BY_RALPH</tag>
		</itemTags>
	</coreAttributes>

	<useDescriptions>
		<selfUse><![CDATA[
		[npc.Name]拧开兔兔果汁的瓶盖，然后开始喝其中的液体。瞬间强烈的胡萝卜味弥漫在[npc.her]的口中，而在贪婪地一口气喝下整瓶饮料后，[npc.she]意识到它有着异常甜美的余味。
		]]></selfUse>
		<otherUse><![CDATA[
		[npc.Name]拧开兔兔果汁的瓶盖，然后让[npc2.name]喝其中的液体。瞬间强烈的胡萝卜味弥漫在[npc2.her]的口中，而在贪婪地一口气喝下整瓶饮料后，[npc2.she]意识到它有着异常甜美的余味。
		]]></otherUse>
	</useDescriptions>

	
</item>
