<?xml version='1.0' encoding='UTF-8' standalone='no'?>
<item>
	<coreAttributes>
		<value>1500</value> 
		<determiner><![CDATA[一瓶]]></determiner>
		<name><![CDATA[莉莉丝的恩馈]]></name>
		<namePlural pluralByDefault="false"><![CDATA[莉莉丝的恩馈]]></namePlural>
		<description><![CDATA[这是一瓶装满了冒泡的粉色液体的玻璃瓶。瓶子上的标签上有一张魅魔完美形状的、心形的臀部的图片。她的纤细手伸向下拉开她柔软的臀瓣，完全暴露出她紧致的肛门和滴水的小穴。]]></description> 
		
		<useDescriptor><![CDATA[喝]]></useDescriptor>
		
		<sexUse>true</sexUse>
		<combatUseAllies>true</combatUseAllies>
		<combatUseEnemies>false</combatUseEnemies>
		<consumedOnUse>true</consumedOnUse>
		
		<rarity>UNCOMMON</rarity> 
		
		<imageName zLayer="0" imageRotation="0" imageSize="100">background_bottom.svg</imageName>
		<imageName zLayer="1" imageRotation="-15" imageSize="80">demon_liliths_gift.svg</imageName>
		<imageName zLayer="2" imageRotation="0" imageSize="100">background_top.svg</imageName>
		
		<colourPrimary>ATTRIBUTE_CORRUPTION</colourPrimary>
		<colourSecondary/>
		<colourTertiary/>
		
		<enchantmentItemTypeId>POTION</enchantmentItemTypeId>
		<enchantmentEffectId>ATTRIBUTE_CORRUPTION</enchantmentEffectId>
		
		<effectTooltipLines>
			<line><![CDATA[[style.boldGood(回复)]10%[style.boldHealth([#ATTRIBUTE_HEALTH_MAXIMUM.getName()])]]]></line>
			<line><![CDATA[[style.boldGood(回复)]10%[style.boldMana([#ATTRIBUTE_MANA_MAXIMUM.getName()])]]]></line>
			<line><![CDATA[[#ATTRIBUTE_MAJOR_CORRUPTION.getFormattedValue(25)]到“药剂效果” ]]></line>
		</effectTooltipLines>
		
		<applyEffects><![CDATA[
			[##npc.incrementHealth(npc.getAttributeValue(ATTRIBUTE_HEALTH_MAXIMUM)/10)]
			[##npc.incrementMana(npc.getAttributeValue(ATTRIBUTE_MANA_MAXIMUM)/10)]
			
			<p style='margin-bottom:0; padding-bottom:0;'>
				一股病态的腐化奥术能量波浪涌过[npc.name]……
			</p>
			[#npc.addPotionEffect(ATTRIBUTE_MAJOR_CORRUPTION, 25)]
		]]></applyEffects>
		
		<itemTags>
			<tag>DRINK</tag>
			<tag>DOMINION_ALLEYWAY_SPAWN</tag>
			<tag>ATTRIBUTE_TF_ITEM</tag>
			<tag>SOLD_BY_RALPH</tag>
		</itemTags>
	</coreAttributes>

	<useDescriptions>
		<selfUse><![CDATA[
		在[npc.name]拔出莉莉丝的恩馈瓶塞的瞬间，[npc.sheIs]立刻流露出喝下瓶中冒着诡异气泡的粉红液体的欲望。在[npc.she]将瓶子送到[npc.her][npc.lips]边的瞬间，[npc.her]立刻开始贪婪地吞咽下液体，并抑制着液体过分甜腻所带来的呕吐感觉。
	]]></selfUse>
		<otherUse><![CDATA[
		[npc.Name]拔出莉莉丝的恩馈的瓶塞，然后将它送到静静等待的[npc2.namePos][npc2.lips]边。[npc2.she]立刻开始吞咽下瓶内的液体，并抑制着液体过分甜腻所带来的呕吐感觉。
		]]></otherUse>
	</useDescriptions>

	
</item>
