<?xml version='1.0' encoding='UTF-8' standalone='no'?>
<item>
	<coreAttributes>
		<value>50</value> 
		<determiner><![CDATA[一条]]></determiner>
		<name><![CDATA[猛禽能量棒]]></name>
		<namePlural pluralByDefault="false"><![CDATA[猛禽能量棒]]></namePlural>
		<description><![CDATA[这是一款猛禽品牌的小型能量棒，背面骄傲地写着“肉含量超过80%”。在包装纸的反面，有一个健壮的隼男正霸道地深喉一个赤裸的鼠女的画面。]]></description> 
		
		<useDescriptor><![CDATA[吃]]></useDescriptor>
		
		<sexUse>true</sexUse>
		<combatUseAllies>true</combatUseAllies>
		<combatUseEnemies>false</combatUseEnemies>
		<consumedOnUse>true</consumedOnUse>
		
		<rarity>RARE</rarity> 
		
		<imageName zLayer="0" imageRotation="0" imageSize="100">background_bottom.svg</imageName>
		<imageName zLayer="1" imageRotation="0" imageSize="70" target1="stroke=&quot;#000&quot;" replacement1="stroke=&quot;#ff5555&quot;" target2="#ff8080" replacement2="#ff5555">res/race/innoxia/raptor/subspecies/icon.svg</imageName>
		<imageName zLayer="2" imageRotation="0" imageSize="70">raptor_energy_bar.svg</imageName>
		<imageName zLayer="3" imageRotation="0" imageSize="100">background_top.svg</imageName>
		
		<colourPrimary>innoxia_raptor</colourPrimary>
		<colourSecondary/>
		<colourTertiary/>
		
		<potionDescriptor><![CDATA[猛禽]]></potionDescriptor>
		<associatedRace>innoxia_raptor</associatedRace>
		<enchantmentItemTypeId>ELIXIR</enchantmentItemTypeId>
		<enchantmentEffectId>RACE</enchantmentEffectId>
		
		<effectTooltipLines>
			<line><![CDATA[[style.boldGood(回复)]15%[style.boldHealth([#ATTRIBUTE_HEALTH_MAXIMUM.getName()])]]]></line>
			<line><![CDATA[[#ATTRIBUTE_HEALTH_MAXIMUM.getFormattedValue(10)]到“药剂效果”]]></line>
			<line><![CDATA[[#ATTRIBUTE_CRITICAL_DAMAGE.getFormattedValue(10)]到“药剂效果” ]]></line>
		</effectTooltipLines>
		
		<applyEffects><![CDATA[
			[##npc.incrementHealth(npc.getAttributeValue(ATTRIBUTE_HEALTH_MAXIMUM) * 0.15)]
			
			<p style='margin-bottom:0; padding-bottom:0;'>
				一股强大的能量冲击涌过[npc.namePos]的身体！
			</p>
			[#npc.addPotionEffect(ATTRIBUTE_HEALTH_MAXIMUM, 10)]
			[#npc.addPotionEffect(ATTRIBUTE_CRITICAL_DAMAGE, 10)]
		]]></applyEffects>
		
		<itemTags>
			<tag>FOOD</tag>
			<tag>DOMINION_ALLEYWAY_SPAWN</tag>
			<tag>ELIS_ALLEYWAY_SPAWN</tag>
			<tag>RACIAL_TF_ITEM</tag>
			<tag>SOLD_BY_RALPH</tag>
			<tag>CAFFEINATED_010</tag>
		</itemTags>
	</coreAttributes>

	<useDescriptions>
		<selfUse><![CDATA[
			撕掉塑料包装，[npc.name]大口咬下猛禽能量棒。尽管它带有一点人工的香精肉味，但一点也不令人讨厌，所以[npc.she]高兴地吃完了，之后[npc.she]迅速感到[npc.herself]充满了能量。
		]]></selfUse>
		<otherUse><![CDATA[
			撕掉塑料包装，[npc.name]让[npc2.name]大口咬下猛禽能量棒。尽管它带有一点人工的香精肉味，但一点也不令人讨厌，所以[npc2.she]高兴地吃完了，之后[npc2.she]迅速感到[npc2.herself]充满了能量。
		]]></otherUse>
	</useDescriptions>

</item>
