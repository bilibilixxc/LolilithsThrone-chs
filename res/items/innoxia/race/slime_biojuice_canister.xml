<?xml version='1.0' encoding='UTF-8' standalone='no'?>
<item>
	<coreAttributes>
		<value>2500</value> 
		<determiner><![CDATA[一罐]]></determiner>
		<name><![CDATA[生物萃取液]]></name>
		<namePlural pluralByDefault="false"><![CDATA[生物萃取液]]></namePlural>
		<description><![CDATA[一罐经过大量加工的粉红色液体，粘稠粘稠的。罐子正面的警告标志清楚地表明，喝下这种液体可不是个好主意……]]></description>
		
		<useDescriptor><![CDATA[喝]]></useDescriptor>
		
		<sexUse>true</sexUse>
		<combatUseAllies>true</combatUseAllies>
		<combatUseEnemies>false</combatUseEnemies>
		<consumedOnUse>true</consumedOnUse>
		<breakOutOfInventory>true</breakOutOfInventory>
		
		<rarity>RARE</rarity> 
		
		<imageName zLayer="0" imageRotation="0" imageSize="100">background_bottom.svg</imageName>
		<imageName zLayer="1" imageRotation="0" imageSize="70" target1="stroke=&quot;#000&quot;" replacement1="stroke=&quot;#ff5555&quot;" target2="#ff8080" replacement2="#ff5555">res/race/innoxia/slime/icon.svg</imageName>
		<imageName zLayer="2" imageRotation="-15" imageSize="75">slime_biojuice_canister.svg</imageName>
		<imageName zLayer="3" imageRotation="0" imageSize="100">background_top.svg</imageName>
		
		<colourPrimary>RACE_SLIME</colourPrimary>
		<colourSecondary/>
		<colourTertiary/>
		
		<potionDescriptor><![CDATA[史莱姆]]></potionDescriptor>
		<associatedRace>SLIME</associatedRace>
		<enchantmentItemTypeId>ELIXIR</enchantmentItemTypeId>
		<enchantmentEffectId>RACE</enchantmentEffectId>
		
		<effectTooltipLines>
			<line><![CDATA[[#ATTRIBUTE_MAJOR_CORRUPTION.getFormattedValue(10)]]]></line>
			<line><![CDATA[[#ATTRIBUTE_MAJOR_CORRUPTION.getFormattedValue(25)]到“药剂效果” ]]></line>
			<line><![CDATA[[style.boldSlime(将身体转化为史莱姆！)]]]></line>
		</effectTooltipLines>
		
		<applyEffects><![CDATA[
			[#npc.incrementAttribute(ATTRIBUTE_MAJOR_CORRUPTION, 10)]
			[#npc.addPotionEffect(ATTRIBUTE_MAJOR_CORRUPTION, 25)]
			
			#IF(npc.getBody().getBodyMaterial()==BODY_MATERIAL_SLIME)
				<p style='margin-bottom:0; padding-bottom:0;'>
					[style.colourDisabled([npc.NameIsFull]已经是史莱姆了，所以无事发生……)]
				</p>
			#ELSEIF(npc.getBody().getBodyMaterial()!=BODY_MATERIAL_FLESH)
				<p style='margin-bottom:0; padding-bottom:0;'>
					[style.colourDisabled([npc.NameIsFull]是元素，所以无事发生……)]
				</p>
			#ELSE
				[#npc.setBodyMaterial(BODY_MATERIAL_SLIME)]
			#ENDIF
		]]></applyEffects>
		
		<itemTags>
			<tag>DRINK</tag>
			<tag>CONTRABAND_LIGHT</tag>
			<tag>RACIAL_TF_ITEM</tag>
			<tag>NOT_FOR_SALE</tag>
		</itemTags>
	</coreAttributes>

	<useDescriptions>
		<selfUse><![CDATA[
		无视标签的警告，[npc.name]拧开生物汁罐的一端，然后把它送到[npc.her]的嘴边。罐中发出微弱的甜味，促使[npc.herHim]仰起头，将所有的液体大口大口地喝下去……
		]]></selfUse>
		<otherUse><![CDATA[
		无视前面的警告，[npc.name]拧开生物汁罐的一端，然后把它送到[npc2.namePos][npc2.lips]前。罐中发出微弱的甜味，促使[npc2.name]仰起头，将所有的液体大口大口地喝下去……
		]]></otherUse>
	</useDescriptions>

	
</item>
