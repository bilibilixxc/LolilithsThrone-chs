<?xml version='1.0' encoding='UTF-8' standalone='no'?>
<item>
	<coreAttributes>
		<value>10</value> 
		<determiner><![CDATA[一瓶]]></determiner>
		<name><![CDATA[小恶魔酿]]></name>
		<namePlural pluralByDefault="false"><![CDATA[小恶魔酿]]></namePlural>
		<description><![CDATA[一个破损肮脏的玻璃瓶，里面装满了乳黄色的液体。瓶子上没有标签，但有人在一边用黑色记号笔写上了 "小恶魔酿"，尽管写得很粗糙，但还是很有用。你想你能猜到这浓稠且雄性味道浓重的液体是什么……]]></description> 
		
		<useDescriptor><![CDATA[喝]]></useDescriptor>
		
		<sexUse>true</sexUse>
		<combatUseAllies>true</combatUseAllies>
		<combatUseEnemies>false</combatUseEnemies>
		<consumedOnUse>true</consumedOnUse>
		
		<rarity>UNCOMMON</rarity> 
		
		<imageName zLayer="0" imageRotation="0" imageSize="100">background_bottom.svg</imageName>
		<imageName zLayer="1" imageRotation="-15" imageSize="80">imp_impish_brew.svg</imageName>
		<imageName zLayer="2" imageRotation="0" imageSize="100">background_top.svg</imageName>
		
		<colourPrimary>ATTRIBUTE_CORRUPTION</colourPrimary>
		<colourSecondary/>
		<colourTertiary/>
		
		<enchantmentItemTypeId>POTION</enchantmentItemTypeId>
		<enchantmentEffectId>ATTRIBUTE_CORRUPTION</enchantmentEffectId>
		
		<effectTooltipLines>
			<line><![CDATA[[style.boldGood(回复)]10%[style.boldMana([#ATTRIBUTE_MANA_MAXIMUM.getName()])]]]></line>
			<line><![CDATA[[#ATTRIBUTE_MAJOR_CORRUPTION.getFormattedValue(50)]到“药剂效果” ]]></line>
		</effectTooltipLines>
		
		<applyEffects><![CDATA[
			[##npc.incrementMana(npc.getAttributeValue(ATTRIBUTE_MANA_MAXIMUM)/10)]
			
			<p style='margin-bottom:0; padding-bottom:0;'>
				一股病态的腐化奥术能量席卷了[npc.name]……
			</p>
			[#npc.addPotionEffect(ATTRIBUTE_MAJOR_CORRUPTION, 50)]
		]]></applyEffects>
		
		<itemTags>
			<tag>DRINK_POOR</tag>
			<tag>SUBMISSION_TUNNEL_SPAWN</tag>
			<tag>ATTRIBUTE_TF_ITEM</tag>
		</itemTags>
	</coreAttributes>

	<useDescriptions>
		<selfUse><![CDATA[
		当[npc.name]拧开小恶魔酿的瓶盖时，[npc.her]的感官立刻受到液体内部的味道浓重的、雄性味道的气味的侵袭。将脏兮兮的瓶子送到[npc.her][npc.lips]边，[npc.she]强迫自己一口气喝下了其中的浓稠的味道浓重的、雄性味道的液体。
		]]></selfUse>
		<otherUse><![CDATA[
		拧开小恶魔酿脏瓶的瓶盖，[npc.name]把它送到[npc2.namePos]等待[npc2.lips]前。[npc2.she]不舒服地哀鸣，强迫自己一口气喝下了其中浓稠且雄性味道浓重的液体。
]]></otherUse>
	</useDescriptions>

	
</item>
