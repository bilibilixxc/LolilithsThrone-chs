<?xml version='1.0' encoding='UTF-8' standalone='no'?>
<item>
	<coreAttributes>
		<value>200</value> 
		<determiner><![CDATA[一瓶]]></determiner>
		<name><![CDATA[黑鼠朗姆酒]]></name>
		<namePlural pluralByDefault="false"><![CDATA[黑鼠朗姆酒]]></namePlural>
		<description><![CDATA[一个装满橙色酒液的 "黑鼠朗姆酒 "玻璃瓶。正面的标签上有一个戴着小偷面具的黑毛老鼠男的图像，他正把一个老鼠女按在墙上，从后面操她。]]></description> 
		
		<useDescriptor><![CDATA[喝]]></useDescriptor>
		
		<sexUse>true</sexUse>
		<combatUseAllies>true</combatUseAllies>
		<combatUseEnemies>false</combatUseEnemies>
		<consumedOnUse>true</consumedOnUse>
		
		<rarity>UNCOMMON</rarity> 
		
		<imageName zLayer="0" imageRotation="0" imageSize="100">background_bottom.svg</imageName>
		<imageName zLayer="1" imageRotation="-15" imageSize="80">rat_black_rats_rum.svg</imageName>
		<imageName zLayer="2" imageRotation="0" imageSize="100">background_top.svg</imageName>
		
		<colourPrimary>ATTRIBUTE_PHYSIQUE</colourPrimary>
		<colourSecondary/>
		<colourTertiary/>
		
		<enchantmentItemTypeId>POTION</enchantmentItemTypeId>
		<enchantmentEffectId>ATTRIBUTE_PHYSIQUE</enchantmentEffectId>
		
		<effectTooltipLines>
			<line><![CDATA[[style.boldGood(回复)]5%[style.boldHealth([#ATTRIBUTE_HEALTH_MAXIMUM.getName()])]]]></line>
			<line><![CDATA[[#ATTRIBUTE_MAJOR_PHYSIQUE.getFormattedValue(1)]到“药剂效果”]]></line>
			<line><![CDATA[[style.boldMinorBad(增加)]50%[style.boldAlcohol(醉酒度)]]]></line>
		</effectTooltipLines>
		
		<applyEffects><![CDATA[
			[##npc.incrementHealth(npc.getAttributeValue(ATTRIBUTE_HEALTH_MAXIMUM)/20)]
			
			<p style='margin-bottom:0; padding-bottom:0;'>
				一股强大的奥术能量浪潮席卷了[npc.name]……
			</p>
			[#npc.addPotionEffect(ATTRIBUTE_MAJOR_PHYSIQUE, 1)]
			[#npc.incrementAlcoholLevel(0.5)]
		]]></applyEffects>
		
		<itemTags>
			<tag>DRINK</tag>
			<tag>ALCOHOLIC</tag>
			<tag>SUBMISSION_TUNNEL_SPAWN</tag>
			<tag>ATTRIBUTE_TF_ITEM</tag>
			<tag>SOLD_BY_RALPH</tag>
		</itemTags>
	</coreAttributes>

	<useDescriptions>
		<selfUse><![CDATA[
		[npc.Name]拧开黑鼠朗姆酒瓶的瓶盖，然后仰起头，狂饮这烈酒。迅速喝光整瓶后，[npc.nameIsFull]的口中留下了一丝微弱的雄性余味。
		]]></selfUse>
		<otherUse><![CDATA[
		[npc.Name]拧开黑鼠朗姆酒瓶的瓶盖，然后把它送到[npc2.namePos]等待[npc2.lips]前，让[npc2.herHim]狂饮这烈酒。迅速喝光整瓶后，[npc2.nameIsFull]的口中留下了一丝微弱的雄性余味。
		]]></otherUse>
	</useDescriptions>

	
</item>
