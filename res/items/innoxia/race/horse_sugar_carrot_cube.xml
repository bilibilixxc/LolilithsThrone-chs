<?xml version='1.0' encoding='UTF-8' standalone='no'?>
<item>
	<coreAttributes>
		<value>15</value> 
		<determiner><![CDATA[一块]]></determiner>
		<name><![CDATA[胡萝卜糖块]]></name>
		<namePlural pluralByDefault="false"><![CDATA[胡萝卜糖块]]></namePlural>
		<description><![CDATA[亮橙色的方糖，散发着胡萝卜的香味。从包装纸上的马蹄形图标来看，这显然是马化形的零食，但其实所有种族都可以食用。]]></description> 
		
		<useDescriptor><![CDATA[吃]]></useDescriptor>
		
		<sexUse>true</sexUse>
		<combatUseAllies>true</combatUseAllies>
		<combatUseEnemies>false</combatUseEnemies>
		<consumedOnUse>true</consumedOnUse>
		
		<rarity>RARE</rarity> 
		
		<imageName zLayer="0" imageRotation="0" imageSize="100">background_bottom.svg</imageName>
		<imageName zLayer="1" imageRotation="0" imageSize="70" target1="stroke=&quot;#000&quot;" replacement1="stroke=&quot;#ff5555&quot;" target2="#ff8080" replacement2="#ff5555">res/race/innoxia/horse/icon.svg</imageName>
		<imageName zLayer="2" imageRotation="0" imageSize="55">horse_sugar_carrot_cube.svg</imageName>
		<imageName zLayer="3" imageRotation="0" imageSize="100">background_top.svg</imageName>
		
		<colourPrimary>RACE_HORSE_MORPH</colourPrimary>
		<colourSecondary/>
		<colourTertiary/>
		
		<potionDescriptor><![CDATA[马]]></potionDescriptor>
		<associatedRace>HORSE_MORPH</associatedRace>
		<enchantmentItemTypeId>ELIXIR</enchantmentItemTypeId>
		<enchantmentEffectId>RACE</enchantmentEffectId>
		
		<effectTooltipLines>
			<line><![CDATA[[style.boldGood(回复)]10%[style.boldHealth([#ATTRIBUTE_HEALTH_MAXIMUM.getName()])]]]></line>
			<line><![CDATA[[#ATTRIBUTE_MAJOR_PHYSIQUE.getFormattedValue(3)]到“药剂效果”]]></line>
		</effectTooltipLines>
		
		<applyEffects><![CDATA[
			[##npc.incrementHealth(npc.getAttributeValue(ATTRIBUTE_HEALTH_MAXIMUM)/10)]
			
			<p style='margin-bottom:0; padding-bottom:0;'>
				[npc.Name]开始感觉强壮了很多……
			</p>
			[#npc.addPotionEffect(ATTRIBUTE_MAJOR_PHYSIQUE, 3)]
		]]></applyEffects>
		
		<itemTags>
			<tag>FOOD</tag>
			<tag>DOMINION_ALLEYWAY_SPAWN</tag>
			<tag>ELIS_ALLEYWAY_SPAWN</tag>
			<tag>RACIAL_TF_ITEM</tag>
			<tag>SOLD_BY_RALPH</tag>
		</itemTags>
	</coreAttributes>

	<useDescriptions>
		<selfUse><![CDATA[
		[npc.Name]撕掉了胡萝卜糖块的纸包装，然后把胡萝卜糖块送进[npc.her]的嘴里。胡萝卜的浓烈味道瞬间袭上了[npc.tongue]，但在享受这个味道之前，它就迅速溶解成一团甜蜜的糖浆，[npc.she]很快就将其一口吞下。
		]]></selfUse>
		<otherUse><![CDATA[
		[npc.Name]撕掉了胡萝卜糖块的纸包装，然后把胡萝卜糖块送进[npc2.namePos]的嘴里。胡萝卜的浓烈味道瞬间袭上了[npc2.namePos]的[npc2.tongue]，但在享受这个味道之前，它就迅速溶解成一团甜蜜的糖浆，[npc2.she]很快就将其一口吞下。
		]]></otherUse>
	</useDescriptions>

	
</item>
