<item>
	<coreAttributes>
		<value>250</value> 
		<determiner><![CDATA[一瓶]]></determiner>
		<name><![CDATA[史莱姆畅饮]]></name>
		<namePlural pluralByDefault="false"><![CDATA[史莱姆畅饮]]></namePlural>
		<description><![CDATA[一个小玻璃瓶，里面装着发光的汽水。正面的标签上写着“史莱姆畅饮”，下面有一张全裸的史莱姆女的照片，她把乳房压在一起，对着你微笑。]]></description> 
		
		<useDescriptor><![CDATA[喝]]></useDescriptor>
		
		<sexUse>true</sexUse>
		<combatUseAllies>true</combatUseAllies>
		<combatUseEnemies>false</combatUseEnemies>
		<consumedOnUse>true</consumedOnUse>
		
		<rarity>UNCOMMON</rarity> 
		
		<imageName zLayer="0" imageRotation="0" imageSize="100">background_bottom.svg</imageName>
		<imageName zLayer="1" imageRotation="-15" imageSize="80">slime_slime_quencher.svg</imageName>
		<imageName zLayer="2" imageRotation="0" imageSize="100">background_top.svg</imageName>
		
		<colourPrimary>GENERIC_SEX</colourPrimary>
		<colourSecondary/>
		<colourTertiary/>
		
		<enchantmentItemTypeId>POTION</enchantmentItemTypeId>
		<enchantmentEffectId>ATTRIBUTE_SEXUAL</enchantmentEffectId>
		
		<effectTooltipLines>
			<line><![CDATA[[style.boldSex(+1)][style.boldWetness(阴道湿度)]]]></line>
			<line><![CDATA[[style.boldSex(+1)][style.boldWetness(肛门湿度)]]]></line>
			<line><![CDATA[[#ATTRIBUTE_DAMAGE_LUST.getFormattedValue(5)]到“药剂效果” ]]></line>
		</effectTooltipLines>
		
		<applyEffects><![CDATA[
			<p style='margin-bottom:0; padding-bottom:0;'>
				一股温暖的奥术能量浪潮席卷了[npc.name]……
			</p>
			[#npc.incrementVaginaWetness(1)]
			[#npc.incrementAssWetness(1)]
			[#npc.addPotionEffect(ATTRIBUTE_DAMAGE_LUST, 5)]
		]]></applyEffects>
		
		<itemTags>
			<tag>DRINK</tag>
			<tag>BAT_CAVERNS_SPAWN</tag>
			<tag>SUBMISSION_TUNNEL_SPAWN</tag>
			<tag>ATTRIBUTE_TF_ITEM</tag>
			<tag>SOLD_BY_RALPH</tag>
		</itemTags>
	</coreAttributes>

	<useDescriptions>
		<selfUse><![CDATA[
		[npc.Name]起掉了史莱姆畅饮瓶的瓶盖，然后开始喝里面的液体。熟悉的甜蜜能量饮料的味道充满了[npc.namePos]的口腔，[npc.she]贪婪地大口灌下下了瓶中所有的发光饮料，仅仅几秒钟就消灭殆尽。
		]]></selfUse>
		<otherUse><![CDATA[
		[npc.Name]起掉了史莱姆饮料瓶的瓶盖，然后让[npc2.name]喝里面的液体。熟悉的甜蜜能量饮料的味道充满了[npc2.namePos]口腔，[npc2.she]贪婪地大口灌下了瓶中所有的发光饮料，仅仅几秒钟就消灭殆尽。
		]]></otherUse>
	</useDescriptions>

	
