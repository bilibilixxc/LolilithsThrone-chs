<?xml version='1.0' encoding='UTF-8' standalone='no'?>
<item>
	<coreAttributes>
		<value>45</value> 
		<determiner><![CDATA[一包]]></determiner>
		<name><![CDATA[比利优选]]></name>
		<namePlural pluralByDefault="false"><![CDATA[比利优选]]></namePlural>
		<description><![CDATA[一个小圆形包装，里面装着非常浓郁的山羊奶酪。包装的顶部标志宣称它是“比利优选”，而底部的标签上显示了一只赤裸的山羊男，你猜测应该是比利，展示他健美的身体。]]></description> 
		
		<useDescriptor><![CDATA[吃]]></useDescriptor>
		
		<sexUse>true</sexUse>
		<combatUseAllies>true</combatUseAllies>
		<combatUseEnemies>false</combatUseEnemies>
		<consumedOnUse>true</consumedOnUse>
		
		<rarity>RARE</rarity> 
		
		<imageName zLayer="0" imageRotation="0" imageSize="100">background_bottom.svg</imageName>
		<imageName zLayer="1" imageRotation="0" imageSize="70" target1="stroke=&quot;#000&quot;" replacement1="stroke=&quot;#ff5555&quot;" target2="#ff8080" replacement2="#ff5555">res/race/innoxia/goat/subspecies/icon.svg</imageName>
		<imageName zLayer="2" imageRotation="0" imageSize="70">goat_billys_best.svg</imageName>
		<imageName zLayer="3" imageRotation="0" imageSize="100">background_top.svg</imageName>
		
		<colourPrimary>innoxia_goat</colourPrimary>
		<colourSecondary/>
		<colourTertiary/>
		
		<potionDescriptor><![CDATA[山羊]]></potionDescriptor>
		<associatedRace>innoxia_goat</associatedRace>
		<enchantmentItemTypeId>ELIXIR</enchantmentItemTypeId>
		<enchantmentEffectId>RACE</enchantmentEffectId> <!-- 'RACE' is a special value, and when defined, this item will use the defined 'associatedRace' to give the player enchantment options for making a TF elixir for that race. -->
		
		<effectTooltipLines>
			<line><![CDATA[[style.boldGood(回复)]10%[style.boldHealth([#ATTRIBUTE_HEALTH_MAXIMUM.getName()])]]]></line>
			<line><![CDATA[[#ATTRIBUTE_MAJOR_PHYSIQUE.getFormattedValue(2)]到“药剂效果”]]></line>
		</effectTooltipLines>
		
		<applyEffects><![CDATA[
			[##npc.incrementHealth(npc.getAttributeValue(ATTRIBUTE_HEALTH_MAXIMUM)/10)]
			
			<p style='margin-bottom:0; padding-bottom:0;'>
				[npc.Name]开始感到更加健康……
			</p>
			[#npc.addPotionEffect(ATTRIBUTE_MAJOR_PHYSIQUE, 2)]
		]]></applyEffects>
		
		<itemTags>
			<tag>FOOD</tag>
			<tag>ELIS_ALLEYWAY_SPAWN</tag>
			<tag>RACIAL_TF_ITEM</tag>
			<tag>SOLD_BY_RALPH</tag>
		</itemTags>
	</coreAttributes>

	<useDescriptions>
		<selfUse><![CDATA[
		[npc.Name]从包装中拿出山羊奶酪，然后迅速吞掉它，留下浓烈、压倒一切的酸奶酪味道充满[npc.her]的口腔。
		]]></selfUse>
		<otherUse><![CDATA[
		[npc.Name]从保护包装中拿出山羊奶酪，然后将它送到[npc2.namePos][npc2.lips]边并让[npc2.herHim]吃。[npc2.name]迅速地吞掉它，留下浓烈、压倒一切的酸奶酪味道充满[npc2.her]的口腔。
]]></otherUse>
	</useDescriptions>

	
</item>
