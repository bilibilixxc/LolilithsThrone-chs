<?xml version='1.0' encoding='UTF-8' standalone='no'?>
<item>
	<coreAttributes>
		<value>75</value> 
		<determiner><![CDATA[一个]]></determiner>
		<name><![CDATA[鸡肉馅饼]]></name>
		<namePlural pluralByDefault="false"><![CDATA[鸡肉馅饼]]></namePlural>
		<description><![CDATA[一个装有混合了蔬菜和肉类的馅饼的小罐头。虽然许多杂食性种族都喜欢这些馅饼的味道，但它们尤其受到狐族变种的喜爱。]]></description> 
		
		<useDescriptor><![CDATA[吃]]></useDescriptor>
		
		<sexUse>true</sexUse>
		<combatUseAllies>true</combatUseAllies>
		<combatUseEnemies>false</combatUseEnemies>
		<consumedOnUse>true</consumedOnUse>
		
		<rarity>RARE</rarity> 
		
		<imageName zLayer="0" imageRotation="0" imageSize="100">background_bottom.svg</imageName>
		<imageName zLayer="1" imageRotation="0" imageSize="70" target1="stroke=&quot;#000&quot;" replacement1="stroke=&quot;#ff5555&quot;" target2="#ff8080" replacement2="#ff5555">res/race/innoxia/fox/icon.svg</imageName>
		<imageName zLayer="2" imageRotation="0" imageSize="70">fox_chicken_pot_pie.svg</imageName>
		<imageName zLayer="3" imageRotation="0" imageSize="100">background_top.svg</imageName>
		
		<colourPrimary>RACE_FOX_MORPH</colourPrimary>
		<colourSecondary/>
		<colourTertiary/>
		
		<potionDescriptor><![CDATA[狐类]]></potionDescriptor>
		<associatedRace>FOX_MORPH</associatedRace>
		<enchantmentItemTypeId>ELIXIR</enchantmentItemTypeId>
		<enchantmentEffectId>RACE</enchantmentEffectId>
		
		<effectTooltipLines>
			<line><![CDATA[[style.boldGood(回复)]10%[style.boldHealth([#ATTRIBUTE_HEALTH_MAXIMUM.getName()])]]]></line>
			<line><![CDATA[[#ATTRIBUTE_MAJOR_PHYSIQUE.getFormattedValue(2)]到“药剂效果”]]></line>
		</effectTooltipLines>
		
		<applyEffects><![CDATA[
			[##npc.incrementHealth(npc.getAttributeValue(ATTRIBUTE_HEALTH_MAXIMUM)/10)]
			
			<p style='margin-bottom:0; padding-bottom:0;'>
				[npc.Name]开始感到更有活力……
			</p>
			[#npc.addPotionEffect(ATTRIBUTE_MAJOR_PHYSIQUE, 2)]
		]]></applyEffects>
		
		<itemTags>
			<tag>FOOD</tag>
			<tag>DOMINION_ALLEYWAY_SPAWN</tag>
			<tag>ELIS_ALLEYWAY_SPAWN</tag>
			<tag>RACIAL_TF_ITEM</tag>
			<tag>SOLD_BY_RALPH</tag>
		</itemTags>
	</coreAttributes>

	<useDescriptions>
		<selfUse><![CDATA[
		[npc.Name]从罐头中拿出鸡肉馅饼，然后将它送到[npc.her]的嘴巴里咬一口。[npc.She]发现它美味、营养丰富的蔬菜和肉类混合物非常软糯，[npc.she]迅速吞噬掉整个馅饼。
		]]></selfUse>
		<otherUse><![CDATA[
		[npc.Name]从罐头中拿出鸡肉馅饼，然后将它送到[npc2.namePos]的嘴巴里并让[npc2.herHim]咬一口。[npc2.She]发现这美味、营养丰富的蔬菜和肉类混合物非常容易软糯，然后[npc2.name]迅速吞噬掉整个馅饼。
		]]></otherUse>
	</useDescriptions>

	
</item>
